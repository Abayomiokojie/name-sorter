{
  "name": "name-sorter",
  "version": "1.0.0",
  "description": "Sorts a list of names by last name, then by given names",
  "main": "src/index.js",
  "bin": {
    "name-sorter": "bin/name-sorter.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/name-sorter.js",
    "build": "node --check bin/name-sorter.js && node --check scripts/check-sorted.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/**/*.unit.test.js\"",
    "test:integration": "node --test \"test/**/*.integration.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-include=bin/** --test-coverage-include=scripts/** \"test/**/*.test.js\"",
    "check": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abayomiokojie/name-sorter.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Abayomiokojie/name-sorter/issues"
  },
  "homepage": "https://github.com/Abayomiokojie/name-sorter#readme"
}
